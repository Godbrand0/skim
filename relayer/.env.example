# Copy to .env (kept out of git) and fill in. Never commit the real file, it holds the relayer's private key.

# Mezo mainnet (chain 31612) and Base mainnet (chain 8453) RPC endpoints. Use paid/private RPCs in production.
MEZO_RPC_URL=https://mainnet.mezo.public.validationcloud.io
BASE_RPC_URL=https://mainnet.base.org

# Mezo to Base direction (the "exit" lane)
FLOAT_ADDRESS=0x...          # MezoFloat on Base (holds USDC)
DEPOSIT_ADDRESS=0x...        # MezoDeposit on Mezo
DEPOSIT_START_BLOCK=0        # Mezo block where MezoDeposit was deployed (set this, scanning from 0 is slow)
TREASURY_ADDRESS=0x...       # Mezo treasury, used by the monitor
FLOAT_TARGET_MICRO=300000000 # float target in USDC micro-units ($300); drives the low-liquidity surcharge
CONFIRMATIONS=5              # Mezo blocks to wait before acting. Verify Mezo finality before lowering.

# Base to Mezo direction (the "enter" lane). Leave these out to run only Mezo to Base.
# ENTER_DEPOSIT_ADDRESS=0x...        # MezoDeposit on Base
# ENTER_DEPOSIT_START_BLOCK=0        # Base block where it was deployed
# ENTER_FLOAT_ADDRESS=0x...          # MezoFloat on Mezo, holding mUSDC
# ENTER_FLOAT_TARGET_MICRO=300000000 # float target in mUSDC micro-units; drives the low-liquidity surcharge
# ENTER_CONFIRMATIONS=10             # Base blocks to wait before acting
# BASE_TREASURY_ADDRESS=0x...        # collects the USDC; used by the monitor

# Payouts are OFF unless this is exactly "true". With it off the relayer only simulates.
ENABLE_PAYOUTS=false
# Hot key that holds RELAYER_ROLE on the floats. Release-only. Must be a plain account (no EIP-7702 delegation)
# with a little gas on Base and, for the enter lane, on Mezo. Load from a secret manager, never commit.
RELAYER_PRIVATE_KEY=

# Server. Hosts such as Render set PORT themselves; leave it out there.
PORT=8787
# HOST=0.0.0.0                       # address to listen on (the default)
# TRUST_PROXY=true                   # set on a host that puts a proxy in front, so rate limits use the real client address
# LOOKBACK_HOURS=48                  # on a host that wipes its disk: after a restart only rescan this many hours
CORS_ORIGIN=http://localhost:5173   # exact origin of the frontend
DB_PATH=./relayer.sqlite
POLL_MS=5000

# Pricing (all optional; defaults shown). Money is in USDC micro-units: 1000000 = $1.
FEE_BPS=200                         # 2% fee
FEE_FLOOR_MICRO=50000               # $0.05 minimum fee
LOW_FLOAT_SURCHARGE_BPS=100         # +1% while a float is under 30% of its target
MUSD_VALUE_BPS=9900                 # value MUSD at $0.99
MUSDC_VALUE_BPS=10000
USDC_VALUE_BPS=10000                # USDC deposited on Base
BTC_SPREAD_BPS=50                   # haircut on the oracle BTC price
MIN_PAYOUT_MICRO=500000             # payouts under $0.50 go to manual review
ORACLE_MAX_AGE_SEC=3600
BATCH_THRESHOLD_MICRO=300000000     # monitor says "rebalance" at $300 of treasury value
